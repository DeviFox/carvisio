# Copy to .env for local development: cp .env.example .env
DATABASE_URL=postgres://carvisio:carvisio@localhost:5432/carvisio
HTTP_ADDR=:8080
# Local dev runs over plain http; in production keep the default (true).
COOKIE_SECURE=false
# Set to true behind nginx so rate limits see the real client IP.
TRUST_PROXY=false
# Next dev server origin, allowed to POST to the API.
ALLOWED_ORIGINS=http://localhost:3017
# Frontend base URL, used in links inside emails.
APP_URL=http://localhost:3017
# Document recognition through OpenRouter. Leave the key empty to turn it off.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# low, medium or high; empty = model default.
OPENROUTER_REASONING_EFFORT=
# Outgoing mail (password reset, feedback). Empty SMTP_HOST = emails go to the log.
# Yandex: smtp.yandex.com, port 465, an app password (not the account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER; Yandex only accepts the login's own address here.
SMTP_FROM=
# Inbox that receives messages from the in-app feedback form.
FEEDBACK_TO=
