# SSH reverse tunnel from the Gemini relay to the API server: port 8090 on
# the API server's localhost leads to Caddy on the relay's localhost.
# Install on the relay as /etc/systemd/system/gemini-tunnel.service.
#
# On the API server, the "tunnel" user may only open this one forward:
#   /home/tunnel/.ssh/authorized_keys:
#     restrict,port-forwarding,permitlisten="127.0.0.1:8090",command="/bin/false" ssh-ed25519 AAAA...
#   /etc/ssh/sshd_config.d/tunnel.conf (drops a dead tunnel so it can reconnect):
#     Match User tunnel
#         ClientAliveInterval 30
#         ClientAliveCountMax 3

[Unit]
Description=Reverse SSH tunnel for the Gemini relay
After=network-online.target caddy.service
Wants=network-online.target

[Service]
User=user
ExecStart=/usr/bin/ssh -N -T -i /data/home/.ssh/relay_tunnel -o BatchMode=yes \
    -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=accept-new \
    -R 127.0.0.1:8090:127.0.0.1:8090 tunnel@168.113.179.192
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
